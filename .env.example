# Copy to .env and fill in the real values. .env is git ignored.
SQLSERVER_ACCEPT_EULA=Y
SQLSERVER_SA_PASSWORD=change_me_to_a_strong_password
SQLSERVER_PORT=1433

# The API and the EF Core design time factory read the connection string from
# ConnectionStrings__DefaultConnection. The other names are read as a fallback.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=ShopCore;User Id=sa;Password=change_me_to_a_strong_password;TrustServerCertificate=True;Encrypt=False

# The API refuses to start without a signing key. Keep it out of the repository.
Jwt__SigningKey=generate_with_openssl_rand_base64_48
Jwt__Issuer=ShopCore
Jwt__Audience=ShopCore.Api

# Only needed to create a local admin through the development seeder.
Identity__DevelopmentAdminEmail=admin@example.test
Identity__DevelopmentAdminPassword=change_me

# Leave disabled unless the API really runs behind a reverse proxy.
Proxy__TrustForwardedHeaders=false
Proxy__KnownProxies=127.0.0.1
Proxy__KnownNetworks=10.0.0.0/8
