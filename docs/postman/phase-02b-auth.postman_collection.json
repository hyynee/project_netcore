          }
        },
        {
          "name": "Dung mat khau NHUNG van 401 (lockout 15 phut)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 - locked out, generic message', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().title).to.eql('Authentication is required.'); });"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{lockEmail}}\",\n  \"password\": \"{{lockPass}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "6. Rate Limiting (can reset window 60-600s neu truoc do da goi nhieu)",
      "item": [
        {
          "name": "Login 6 lan -> van 401 (DANG BUG: auth-login policy 5/min khong apply, thay vao la 'api' 120/min)",
          "event": [{ "listen": "test", "script": { "exec": [
            "console.log('Chay 6 lan, can 429 o lan 6 neu auth-login policy hoat dong. Hien tai chi thay 429 o lan 121 = policy api.');"
          ]}}],
          "request": {
            "method": "POST", "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Auth-Account", "value": "ratelimit-probe@example.test" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ratelimit-probe@example.test\",\n  \"password\": \"WrongPassw0rd!1\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "7. OpenAPI",
      "item": [
        {
          "name": "Swagger JSON co auth endpoints",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('co /api/v1/auth/register', () => pm.expect(pm.response.text()).to.include('/api/v1/auth/register'));",
            "pm.test('co /api/v1/auth/login', () => pm.expect(pm.response.text()).to.include('/api/v1/auth/login'));",
            "pm.test('co /api/v1/auth/refresh', () => pm.expect(pm.response.text()).to.include('/api/v1/auth/refresh'));",
            "pm.test('co /api/v1/auth/logout', () => pm.expect(pm.response.text()).to.include('/api/v1/auth/logout'));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/swagger/v1/swagger.json" }
        }
      ]
