{
  "info": {
    "name": "ShopCore Phase 02b - Identity & Auth",
    "description": "Verify Phase 02b trên real SQL Server. Chạy theo thứ tự: Health → Register → Login → Refresh Rotation → Logout → Reuse Detection.\n\nYêu cầu: API đang chạy (https://localhost:7282 hoặc http://localhost:5130), env đã set Jwt__SigningKey + ConnectionStrings__DefaultConnection.\n\nLưu ý: Register/Login có rate-limit theo IP (đang dùng policy 'api' 120/phút thay vì policy auth-* — xem báo cáo verify). Nếu bị 429, chờ 60s rồi chạy tiếp."
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7282" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "rotatedRefreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Live",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/health/live" }
        },
        {
          "name": "Ready (DB check)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        }
      ]
    },
    {
      "name": "1. Register",
      "item": [
        {
          "name": "Register hop le (201)",
          "event": [{ "listen": "prerequest", "script": { "exec": [
            "const ts = Date.now();",
            "pm.environment.set('email', `alice${ts}@example.test`);",
            "pm.environment.set('password', 'AlicePassw0rd!2026');"
          ]}}, { "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('co accessToken', () => pm.expect(pm.response.json().accessToken).to.not.be.empty);",
            "pm.environment.set('accessToken', pm.response.json().accessToken);",
            "pm.environment.set('refreshToken', pm.response.json().refreshToken);"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Register email sai (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 + problem+json', () => { pm.response.to.have.status(400); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"Str0ng!Passw0rdX\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Register mat khau yeu (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"weak@example.test\",\n  \"password\": \"Short1!\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Register trung email (400 + lo thong tin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400/409', () => pm.expect([400,409]).to.include(pm.response.code));",
            "pm.test('CANH BAO: response tiet le email da ton tai', () => { const b = pm.response.json(); pm.expect(JSON.stringify(b)).to.not.include('already taken'); });"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Register over-post id/isAdmin (van 201, field thua bi bo qua)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 - field thua bi bo qua', () => pm.response.to.have.status(201));",
            "pm.test('id trong body khong duoc chon (phan hoi id khac)', () => { const b = pm.response.json(); const uid = JSON.parse(atob(b.accessToken.split('.')[1])).sub; pm.expect(uid).to.not.equal('11111111-1111-1111-1111-111111111111'); });"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"overpost-{{email}}\",\n  \"password\": \"OverPost!Passw0rd2026\",\n  \"id\": \"11111111-1111-1111-1111-111111111111\",\n  \"isAdmin\": true,\n  \"roles\": [\"Admin\"]\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "item": [
        {
          "name": "Login dung (200 + JWT)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.environment.set('accessToken', b.accessToken);",
            "pm.environment.set('refreshToken', b.refreshToken);",
            "const p = JSON.parse(atob(b.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
            "pm.test('JWT iss=ShopCore', () => pm.expect(p.iss).to.eql('ShopCore'));",
            "pm.test('JWT aud=ShopCore.Api', () => pm.expect(p.aud).to.eql('ShopCore.Api'));",
            "pm.test('JWT TTL <= 15 phut', () => pm.expect(p.exp - p.iat).to.be.at.most(930));",
            "pm.test('JWT co claim sub', () => pm.expect(p.sub).to.not.be.undefined);"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login sai mat khau (401 generic)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('khong co detail/stack trace', () => { const b = pm.response.json(); pm.expect(b.detail).to.be.undefined; pm.expect(JSON.stringify(b)).to.not.match(/password|stack/i); });",
            "pm.test('title generic', () => pm.expect(pm.response.json().title).to.eql('Authentication is required.'));"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPassw0rd!999\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login email khong ton tai (401 - giong het truong hop sai mat khau)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('cung title = khong lo ton tai email', () => pm.expect(pm.response.json().title).to.eql('Authentication is required.'));"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ghost-none@example.test\",\n  \"password\": \"Whatever12345!\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "3. Refresh Rotation + Reuse Detection",
      "item": [
        {
          "name": "Refresh - lan 1 (200, token moi)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const nt = pm.response.json().refreshToken;",
            "pm.test('token moi khac token cu', () => pm.expect(nt).to.not.eql(pm.environment.get('refreshToken')));",
            "pm.environment.set('rotatedRefreshToken', nt);"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "REUSE token cu NGAY (401, trong grace 5s - khong revoke family)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Token moi van hop le (vi reuse trong grace)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 - family chua bi revoke vi reuse trong grace 5s', () => pm.response.to.have.status(200));",
            "pm.environment.set('refreshToken', pm.response.json().refreshToken);"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{rotatedRefreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "REUSE sau grace 5s (401 + REVOKE CA FAMILY)",
          "event": [{ "listen": "prerequest", "script": { "exec": [
            "console.log('Cho 6s de vuot grace period truoc khi reuse...');"
          ]}}, { "listen": "test", "script": { "exec": [
            "pm.test('401 - token da reuse', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{rotatedRefreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Refresh token gia (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"totally-made-up-token\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "4. Logout",
      "item": [
        {
          "name": "Logout khong co token (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"not-a-token\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Logout token hong (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer invalid.token.here" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"not-a-token\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Logout hop le (204)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Refresh SAU logout (401 - token da thu hoi)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 - refresh token da logout bi reject', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        }
      ]
    },
